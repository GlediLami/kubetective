# Release image, built by goreleaser from already-compiled binaries.
#
# Two Dockerfiles, on purpose. The top-level Dockerfile compiles from source so
# `docker build .` works on a clean checkout (hack/smoke-container.sh relies on
# that). goreleaser does not hand its docker build a source tree — the context
# holds the binaries it just built and whatever `extra_files` names — so a
# from-source Dockerfile fails there with "/NOTICE": not found, which is
# exactly how the first v1.0.1 attempt died.
#
# Same base, same user, same layout as the source build; only the provenance of
# the binary differs. The version stamp comes from goreleaser's ldflags rather
# than a hardcoded -X here, so there is no second place to keep in sync.
FROM gcr.io/distroless/static-debian12:nonroot

COPY kubetective /usr/local/bin/kubetective
COPY kubectl-investigate /usr/local/bin/kubectl-investigate
COPY LICENSE /usr/share/licenses/kubetective/LICENSE
COPY NOTICE /usr/share/licenses/kubetective/NOTICE

# Incident store + config live on the default state dir; keep it writable
# by the non-root user (65532).
ENV KUBETECTIVE_HOME=/data/kubetective
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/kubetective"]
CMD ["serve", "--listen", ":8080"]
